[alias]
  l = "!. ~/.githelpers && pretty_git_log"
  co = checkout
	sync = !git fetch origin main:main && git rebase main

[core]
	editor = nvim
  pager = less -F -X
	excludesfile = /Users/scott.savage/.gitignore

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# Default fallback - personal config for all repos
[include]
  path = ~/.gitconfig_personal

# Conditional includes based on repo location (these override the default)
[includeIf "gitdir:~/grnhse/"]
  path = ~/.gitconfig_local

[includeIf "gitdir:~/snsavage/"]
  path = ~/.gitconfig_personal

[init]
  defaultBranch = main

[merge]
  ff = only

[safe]
  directory = /todo

[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[pull]
	ff = only
[push]
	autoSetupRemote = true
