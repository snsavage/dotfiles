# vim: set filetype=bash
source /opt/homebrew/share/antigen/antigen.zsh
antigen init ~/.antigenrc

# XDG Config
export XDG_CONFIG_HOME="${HOME}/.config"

# Aliases
alias back=back_to_git_root
alias diff="/opt/homebrew/bin/diff --color --side-by-side"
alias dotfiles="cd ~/dotfiles && vim ."
alias eza='LS_COLORS=" " eza'
alias lah="eza -lah --icons --group-directories-first"
alias oldvim="vim"
alias reload="source ~/.zshrc"
alias savage='rg "SAVAGE\:"'
alias todo='git grep -EI "TODO"'
alias vi="nvim"
alias vim="nvim"
alias k="kubectl"
alias lz="lazygit"
alias scratch="cd ~/gh/scratch"
alias tree="tree -a"

kswitch() {
  if [ $# -eq 2 ]; then
    kubectx $1 && kubens $2
  else
    echo "Usage: kswitch <context> <namespace>"
  fi
}

alias kx='kubectx'
alias kn='kubens'
alias ks='kswitch'

# Caffeinate
alias caf='caffeinate -d >/dev/null'
alias decaf='kill $(pgrep caffeinate)'

# Docker
# alias docker-container-rm="docker container rm -f $(docker container ls -aq)"
# alias docker-image-rm="docker image rm -f $(docker image ls -f reference='diamol/*' -q)"

# Zsh Config
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=blue'

# pushd
setopt AUTO_PUSHD           # Push the current directory visited on the stack.
setopt PUSHD_IGNORE_DUPS    # Do not store duplicates in the stack.
setopt PUSHD_SILENT         # Do not print the directory stack after pushd or popd.
alias d='dirs -v'

# asdf
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fpath=(${ASDF_DATA_DIR:-$HOME/.asdf}/completions $fpath)
export ASDF_GOLANG_MOD_VERSION_ENABLED=true

# Exports
export EDITOR="nvim"
export LDFLAGS="-L/opt/homebrew/opt/libffi/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libffi/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/libffi/lib/pkgconfig"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="/opt/homebrew/opt/make/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/findutils/libexec/gnubin:$PATH"
export PATH="$(brew --prefix)/opt/coreutils/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="${HOME}/go/bin:$PATH"
export PATH="${HOME}/dotfiles/scripts:$PATH"
export PATH="/opt/homebrew/opt/gnu-tar/libexec/gnubin:$PATH"
export GOBIN="${HOME}/go/bin"
export BAT_CONFIG_PATH="${HOME}/.config/bat/bat.conf"
export KUBE_EDITOR=vim

# direnv
export DIRENV_LOG_FORMAT=''
back_to_git_root() {
    if git rev-parse --git-dir > /dev/null 2>&1; then
        cd $(git rev-parse --show-toplevel)
    fi
}

# Starship.rs Setup
eval "$(starship init zsh)"

if [ -f ~/.zshrc_local ]; then
    # SAVAGE: Wrap this to a function to handle missing 'gum'.
    gum log --time rfc822 --level info "Sourcing ~/.zshrc_local"
    source ~/.zshrc_local
else
    gum log --time rfc822 --level info "No ~/.zshrc_local found"
fi

ulimit -n 100000

# FZF Setup
if type rg &> /dev/null; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden --smart-case'
  export FZF_DEFAULT_OPTS='-m --height 50% --border'
fi

eval "$(direnv hook zsh)"

# Enable vi mode
bindkey -v

# https://github.com/zsh-users/zsh-history-substring-search
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down

# Kubectl Contexts
# export KUBECONFIG="$(~/dotfiles/scripts/load-k8s-configs.sh)"
export KUBECONFIG=~/.kube/config


# Tmux
# Detect VS Code/Cursor integrated terminal
# This causes issues with tmux.
_is_vscode() { [[ -n "$VSCODE_PID" ]] }
_is_cursor() { [[ -n "$CURSOR_PID" ]] }
_is_ide_terminal() { _is_vscode || _is_cursor }

# Use this in your tmux logic
ensure_tmux_is_running() {
  if _not_inside_tmux && ! _is_ide_terminal; then
    ~/dotfiles/scripts/tat.sh
  fi
}

ensure_tmux_is_running

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export PATH="/opt/homebrew/opt/gnu-getopt/bin:$PATH"

